#!/bin/bash

### 融合版（sddvcm/workbuddy-api）在飞牛 fnOS 上的启动/停止控制。
###
### 与同仓库的 wb2api+（workbuddy2api-panel）不同：这个程序**只从 workDir 下的
### config.json 取配置**，环境变量里只有 WILDWORK_HOME 会被它自己读走，其余
### WILDWORK_* 是官方容器 entrypoint.sh 用来现生成 config.json 的中间量。
### 所以安装脚本必须在拉起进程前把 config.json 落盘，否则向导里填的端口和密码
### 会被静默忽略（现象是程序按 :7863 + 随机 key 起来了）。

LISTEN_PORT="${port:-7865}"
WIZ_PWD="${pwd:-}"

CFG_DIR="${TRIM_PKGVAR}"
CFG_FILE="${TRIM_PKGVAR}/config.json"
AUTH_DIR="${TRIM_PKGVAR}/auths"
STATE_FILE="${TRIM_PKGVAR}/state.json"
SECRET_FILE="${TRIM_PKGVAR}/first-boot-secret.txt"

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
BIN="${TRIM_APPDEST}/bin/workbuddy-api"

export WILDWORK_HOME="${CFG_DIR}"
export WILDWORK_REGION="cn"

# listen_env_for_start：本次启动是否要把向导端口注入 WILDWORK_LISTEN。
#
# config.json 是监听端口的唯一真源（与凭据同一套归属）：
#   - 文件不存在（首次启动）→ 输出 ":{port}"，由 write_config 落盘；
#   - 文件已存在 → 输出空串（**不注入**）。config.applyEnv 在解析文件之后执行，
#     只看环境变量是否非空，一旦注入就会盖掉面板/文件里的 listen。
# 返回空串时调用方负责 unset，避免从父进程继承到旧值。
listen_env_for_start() {
    if [ -f "$CFG_FILE" ]; then
        printf ''
    else
        printf ':%s' "$LISTEN_PORT"
    fi
}

# effective_listen：config.json 里实际生效的监听地址，仅供日志与失败提示使用。
# 程序落盘是 {"host":...,"port":...} 对象，脚本首次写的是 ":7865" 字符串，两种都要认。
effective_listen() {
    if [ -f "$CFG_FILE" ]; then
        s=$(sed -n 's/^[[:space:]]*"listen"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CFG_FILE" | head -n 1)
        if [ -n "$s" ]; then
            printf '%s' "$s"
            return 0
        fi
        p=$(sed -n '/"listen"[[:space:]]*:[[:space:]]*{/,/}/p' "$CFG_FILE" \
            | sed -n 's/.*"port"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n 1)
        if [ -n "$p" ]; then
            printf ':%s' "$p"
            return 0
        fi
    fi
    printf ':%s' "$LISTEN_PORT"
}

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

# json_escape：转义 \ 和 "，并吃掉换行。
# 向导密码含引号时若不转义，生成的 config.json 直接非法，程序启动即崩。
json_escape() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\r\n\t'
}

# resolve_secret：面板登录密码 = API Key（与 wb2api+ 的习惯保持一致）。
# 监听 :${LISTEN_PORT} 属于对外暴露，而这个程序在「对外监听 + 无管理密码」时
# **拒绝启动**，所以向导留空时必须自己造一个稳定值并留在包里可查。
resolve_secret() {
    if [ -n "$WIZ_PWD" ]; then
        SECRET="$WIZ_PWD"
        return 0
    fi
    if [ -f "$SECRET_FILE" ]; then
        SECRET=$(head -n 1 "$SECRET_FILE" | tr -d '[:space:]')
        [ -n "$SECRET" ] && return 0
    fi
    SECRET=$(tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 24)
    printf '%s\n' "$SECRET" > "$SECRET_FILE"
    chmod 600 "$SECRET_FILE"
    log_msg "向导未填密码，已生成随机密码并写入 ${SECRET_FILE}"
    return 0
}

# repair_listen_block 自愈旧版脚本写坏的 config.json。
#
# 来历见 write_config 注释：旧版按行 sed 回写 listen，而程序把 listen 落盘成多行对象，
# 于是留下孤儿行 → JSON 非法 → 程序启动即 fatal（v0.1.10 实发）。
#
# 判定刻意保守，避免把健康文件改坏：
#   1. 只认**标量** listen（值在同一行闭合）。对象形态的 `  "listen": {` 绝不匹配 ——
#      否则会连正常的对象配置一起删掉。
#   2. 还要**前瞻**下一行确实是 4 空格缩进的孤儿行，才进入删除态。
#   3. 必须找到与之配对的收尾 `  }` / `  },` 才真的删；找不到就一个字不动
#      （收尾有没有逗号都要能吃掉 —— 旧实现写死「三行 + `},`」，遇到无逗号收尾就修不好）。
#   4. 只在「确实删掉了行」时才替换原文件，并先 cp -p 备份、保持 0600
#      （文件里有 api_key 与管理面板密码，绝不能放宽成 0644 让同机任意用户可读）。
repair_listen_block() {
    [ -f "$CFG_FILE" ] || return 0
    # 先做低成本探测：标量 listen + 紧跟 4 空格行 = 损坏特征。不匹配就完全不碰文件。
    grep -q '^  "listen": "' "$CFG_FILE" 2>/dev/null || return 0
    grep -A1 '^  "listen": "' "$CFG_FILE" 2>/dev/null | grep -q '^    ' || return 0

    tmp="${CFG_FILE}.repair"
    # umask 077 让 awk 新建的临时文件天然是 0600；即使后续失败残留也不会泄露凭据。
    (
      umask 077
      awk '
        { a[NR] = $0; sub(/\r$/, "", a[NR]) }
        END {
            # 第一遍：标记要丢掉的孤儿行（含与之配对的收尾 } / },）
            for (i = 1; i <= NR; i++) {
                if (a[i] ~ /^  "listen": "[^"]*"[ ]*,?[ ]*$/ && a[i+1] ~ /^    /) {
                    j = i + 1
                    while (j <= NR && a[j] ~ /^    /) { j++ }
                    if (j <= NR && a[j] ~ /^  \},?[ ]*$/) {
                        for (k = i + 1; k <= j; k++) del[k] = 1
                        i = j
                    }
                }
            }
            # 第二遍：输出。丢掉孤儿块后，listen 可能变成「最后一项」却还带着逗号
            # （`"listen": ":7865",` 紧跟收尾 `}` 是非法 JSON）—— 必须把悬空逗号去掉。
            for (i = 1; i <= NR; i++) {
                if (del[i]) continue
                line = a[i]
                nxt = ""
                for (k = i + 1; k <= NR; k++) { if (!del[k]) { nxt = a[k]; break } }
                if (line ~ /,[ ]*$/ && nxt ~ /^\}[ ]*$/) sub(/,[ ]*$/, "", line)
                print line
            }
        }
      ' "$CFG_FILE" > "$tmp"
    ) || { log_msg "repair_listen_block: awk 失败，保持原文件不动"; return 0; }

    before=$(wc -l < "$CFG_FILE"); after=$(wc -l < "$tmp")
    if [ "$after" -lt "$before" ]; then
        cp -p "$CFG_FILE" "${CFG_FILE}.bak" 2>/dev/null
        mv "$tmp" "$CFG_FILE"
        chmod 600 "$CFG_FILE" 2>/dev/null
        log_msg "已清理 config.json 的 listen 孤儿行（${before} → ${after} 行，原件备份为 config.json.bak）"
    else
        # 结构没认出来：不写回，保留 0600 的 .repair 供人工排查（绝不动用户的 config.json）
        log_msg "repair_listen_block: 未匹配到可安全清理的结构，保持 config.json 原样（候选结果留在 ${tmp}）"
    fi
    return 0
}

write_config() {
    mkdir -p "$CFG_DIR" "$AUTH_DIR"
    if [ ! -f "$CFG_FILE" ]; then
        # umask 077 + 显式 chmod：这份文件里有 api_key 和管理面板密码，
        # 默认 umask 建出来是 0644，NAS 上同机任意用户/其它容器都能读走凭据。
        ( umask 077
          cat > "$CFG_FILE" <<EOF
{
  "listen": ":${LISTEN_PORT}",
  "api_key": "$(json_escape "$SECRET")",
  "admin_password": "$(json_escape "$SECRET")",
  "auth_dir": "${AUTH_DIR}",
  "state_file": "${STATE_FILE}",
  "region": "${WILDWORK_REGION}"
}
EOF
        )
        chmod 600 "$CFG_FILE" 2>/dev/null
        log_msg "首次启动：生成 ${CFG_FILE}（listen=:${LISTEN_PORT}，权限 600）"
        return 0
    fi
    # 已存在：一个字都不改。
    #
    # 为什么彻底放弃按行回写（旧版这里会 sed 改 listen / api_key / admin_password）：
    #   ① 程序用 MarshalIndent 整体重写 config.json，Listen 是 {host, port} 结构体且
    #      没有自定义 MarshalJSON，落盘是多行对象；按行替换只动了首行，剩下的
    #      host/port/}, 变孤儿行 → JSON 非法 → LoadOrCreate 失败 → main.go fatal 退出。
    #      这就是 v0.1.10「应用中心点打开后几秒退回启用按钮、重启也救不回」的根因。
    #   ② sed 替换串里的 & 会展开成整行匹配、值含 | 会让表达式静默不生效：管理密码带
    #      这两个字符就当场把配置写坏（已实测复现 `"api_key": "a  "api_key": "old",b"`）。
    #   ③ 归属：凭据（api_key / admin_password）本就以文件为准（脚本不再导出这两项
    #      环境变量）；监听端口也改为只在首次启动注入，文件存在时不再导出
    #      WILDWORK_LISTEN —— 否则 applyEnv 会盖掉面板改过的端口。
    # 结论：config.json 是唯一真源；向导值只在文件缺失时用来生成它。
    log_msg "config.json 已存在，保持不动（监听/密钥均以 ${CFG_FILE} 为准）"
    return 0
}

start_process() {
    if pgrep -f "${BIN}" > /dev/null 2>&1; then
        log_msg "found existing process, killing..."
        pkill -f "${BIN}"
        sleep 1
    fi

    resolve_secret
    # 端口归属：首次启动用向导 port，之后以 config.json 为准（见 listen_env_for_start）。
    listen_env=$(listen_env_for_start)
    if [ -n "$listen_env" ]; then
        export WILDWORK_LISTEN="$listen_env"
        log_msg "首次启动：使用向导端口（WILDWORK_LISTEN=${listen_env}）"
    else
        unset WILDWORK_LISTEN
        log_msg "config.json 已存在：监听以文件为准（$(effective_listen)），忽略向导端口 ${LISTEN_PORT}"
    fi
    write_config
    # 必须在拉起进程之前跑：config.json 非法会让程序启动即 fatal 退出。
    repair_listen_block

    log_msg "Starting process ..."
    # --no-tray：NAS 上没有桌面环境，带托盘会 panic（官方镜像同样这么起）。
    #
    # 输出必须落进 info.log：程序在「config.json 非法 / 端口被占 / 对外监听未设管理密码」
    # 时是 fatal 退出并把原因打到 stderr。旧版写的是 `2>&1 &` 不落地，用户只能看到
    # 「点了没起来」，零线索 —— 本次事故排查成本全拜此所赐。
    bash -c "${BIN} --no-tray" >> "${LOG_FILE}" 2>&1 &
    pid=$!
    printf "%s" "$pid" > ${PID_FILE}
    # 起来后要校验。旧版 start_process 无论成败都 return 0，进程秒退时应用中心照样显示
    # 「运行中」，故障被完全吞掉（现象就是「点打开，几秒后自己退回启用按钮」却毫无提示）。
    sleep 2
    if ! check_process "$pid"; then
        log_msg "启动失败：进程已退出（pid=${pid}）。请看 ${LOG_FILE} 末尾的 fatal 原因 —— 常见：config.json 非法、端口 $(effective_listen) 被占用、对外监听未设管理密码"
        return 1
    fi
    log_msg "进程已启动 pid=${pid} listen=$(effective_listen)（config.json 优先）"
    return 0
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')

        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            rm -f ${PID_FILE}
            log_msg "remove pid file 1"
            return
        fi

        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM ${pid} >> ${LOG_FILE} 2>&1

        count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}"
            sleep 1
            rm -f ${PID_FILE}
        else
            log_msg "process killed... "
        fi
    fi

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f ${PID_FILE}
        fi
    fi

    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
