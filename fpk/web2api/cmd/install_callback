#!/bin/bash

### 安装后调用：准备数据目录。
### 程序把 SQLite（webai2api.db）与浏览器档案放在 ./data/ 下，工作目录就是 TRIM_PKGVAR，
### 因此这里只需要保证目录存在且属主正确。

mkdir -p "${TRIM_PKGVAR}/data"

# 固化「面板可从局域网访问」补丁：飞牛无图形界面，内置浏览器登录不可用，
# 只能手动粘凭证，而原版面板把非本机访问一律 403 —— 不打这个补丁，用户根本进不去。
# 补丁只放宽到 RFC1918/回环，公网仍拒绝；重复执行幂等。
PYBIN="$(ls /vol2/@appcenter/python312/bin/python3.12 2>/dev/null | head -1)"
[ -z "${PYBIN}" ] && PYBIN="$(ls /vol1/@appcenter/python312/bin/python3.12 2>/dev/null | head -1)"
[ -z "${PYBIN}" ] && PYBIN="$(command -v python3 2>/dev/null)"
PATCH="${TRIM_APPDEST}/patches/allow-lan-admin.py"
if [ -n "${PYBIN}" ] && [ -f "${PATCH}" ]; then
    "${PYBIN}" "${PATCH}" "${TRIM_APPDEST}/pysite/webai2api/app.py" >> "${TRIM_PKGVAR}/patch.log" 2>&1 \
        && echo "lan-admin patch applied" >> "${TRIM_PKGVAR}/patch.log"
fi
# 程序把数据写在「包目录旁的 data/」，软链到持久化目录（升级不丢账号/密钥）
ln -sfn "${TRIM_PKGVAR}/data" "${TRIM_APPDEST}/pysite/data" 2>/dev/null
chmod 700 "${TRIM_PKGVAR}" 2>/dev/null

exit 0
